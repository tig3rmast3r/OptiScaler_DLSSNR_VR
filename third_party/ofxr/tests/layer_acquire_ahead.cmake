foreach(required IN ITEMS LAYER_DLL CALL_CHAIN ENABLED_INI WORK_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} was not provided")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_DIR}")
file(GLOB old_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
if(old_logs)
    file(REMOVE ${old_logs})
endif()
file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
configure_file("${ENABLED_INI}" "${WORK_DIR}/ofxr_bridge.ini" COPYONLY)
get_filename_component(layer_name "${LAYER_DLL}" NAME)
execute_process(COMMAND "${CALL_CHAIN}" "${WORK_DIR}/${layer_name}"
    "${WORK_DIR}/fake-runtime.log" acquire-ahead
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    TIMEOUT 30)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Acquire-ahead call chain failed (${result}): ${output}\n${error}")
endif()
file(GLOB logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
list(LENGTH logs log_count)
if(NOT log_count EQUAL 1)
    message(FATAL_ERROR "Expected one capture log, got ${log_count}")
endif()
list(GET logs 0 log)
file(READ "${log}" contents)
string(REGEX MATCHALL "phase=B op=history_capture [^\r\n]*" captures "${contents}")
list(LENGTH captures capture_count)
if(capture_count LESS 5)
    message(FATAL_ERROR "Acquired image ownership was lost: fewer than five history captures")
endif()
math(EXPR offset "${capture_count} - 5")
set(expected 0 1 2 0 1)
foreach(i RANGE 0 4)
    math(EXPR position "${offset} + ${i}")
    list(GET captures ${position} capture)
    list(GET expected ${i} image)
    if(NOT capture MATCHES " b=${image} c=0$")
        message(FATAL_ERROR "History copied wrong image for step ${i}: ${capture}")
    endif()
endforeach()
message(STATUS "PASS: multiple waits, acquire before begin, waited image across end/begin, extra accepted wait; captures 0/1/2/0/1")
