if(NOT DEFINED LAYER OR NOT DEFINED SMOKE OR NOT DEFINED SCRATCH)
  message(FATAL_ERROR "Missing exclusion fixture paths")
endif()
file(MAKE_DIRECTORY "${SCRATCH}")
file(COPY "${LAYER}" DESTINATION "${SCRATCH}")
get_filename_component(DLL_NAME "${LAYER}" NAME)
get_filename_component(EXE_NAME "${SMOKE}" NAME)
file(WRITE "${SCRATCH}/ofxr_bridge.ini" "[ofxr]\nexcluded_processes=${EXE_NAME}\n")
execute_process(COMMAND "${SMOKE}" "${SCRATCH}/${DLL_NAME}" --expect-excluded RESULT_VARIABLE excluded)
if(NOT excluded EQUAL 0)
  message(FATAL_ERROR "Explicit exclusion was not honored")
endif()
file(WRITE "${SCRATCH}/ofxr_bridge.ini" "[ofxr]\nexcluded_processes=\n")
execute_process(COMMAND "${SMOKE}" "${SCRATCH}/${DLL_NAME}" RESULT_VARIABLE allowed)
if(NOT allowed EQUAL 0)
  message(FATAL_ERROR "Explicitly empty exclusion list must allow negotiation")
endif()
